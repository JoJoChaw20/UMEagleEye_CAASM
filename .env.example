# ── Database ──
DATABASE_URL=postgresql+asyncpg://eagleeye:eagleeye_secret@db:5432/umeagleeye
DATABASE_URL_SYNC=postgresql://eagleeye:eagleeye_secret@db:5432/umeagleeye
POSTGRES_USER=eagleeye
POSTGRES_PASSWORD=eagleeye_secret
POSTGRES_DB=umeagleeye

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── JWT / Auth ──
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── OpenRouter AI (DeepSeek) ──
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ── Google Cloud Storage ──
GCS_BUCKET_NAME=umeagleeye-reports
GCS_SERVICE_ACCOUNT_KEY=your-gcs-key-here

# ── MyCERT TAXII ──
MYCERT_TAXII_URL=https://taxii.mycert.org.my/taxii2/
MYCERT_USERNAME=
MYCERT_PASSWORD=

# ── AlienVault OTX & ThreatFox ──
OTX_API_KEY=
OTX_TAXII_URL=https://otx.alienvault.com/taxii/discovery
THREATFOX_API_KEY=

# ── NVD API ──
NVD_API_KEY=

# ── Scanning ──
SCAN_DEFAULT_SUBNET=192.168.1.0/24
SCAN_RATE_LIMIT=1000
DISCOVERY_CYCLE_MINUTES=15

# ── App ──
APP_NAME=UMEagleEye
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
