{
  "name": "umeagleeye-workers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "node scripts/db/db.mjs generate",
    "db:status:staging": "node scripts/db/db.mjs status staging",
    "db:status:prod": "node scripts/db/db.mjs status production",
    "db:migrate:staging": "node scripts/db/db.mjs migrate staging",
    "db:migrate:prod": "node scripts/db/db.mjs migrate production",
    "db:baseline:prod": "node scripts/db/db.mjs baseline production",
    "db:baseline:prod:apply": "node scripts/db/db.mjs baseline production --apply",
    "db:staging:mark": "node scripts/db/staging.mjs mark",
    "db:staging:sanitize": "node scripts/db/staging.mjs sanitize",
    "db:staging:sanitize:apply": "node scripts/db/staging.mjs sanitize --apply",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.1",
    "@neondatabase/serverless": "^0.10.1",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241210.0",
    "@types/node": "^25.8.0",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.91.0"
  }
}
