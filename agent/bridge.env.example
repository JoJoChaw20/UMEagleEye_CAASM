# UMEagleEye Bridge Configuration
# Copy to bridge.env and fill in values

# Cloudflare Worker API URL (must end with /api/v1)
WORKER_URL=https://umeagleeye-api.syntaxch404.workers.dev/api/v1

# Bridge credentials — obtain from Agents page after registering a bridge
BRIDGE_ID=your-bridge-uuid-here
BRIDGE_API_KEY=your-bridge-api-key-here

# Port the bridge listens on (agents point their --api-url here)
LISTEN_PORT=8080

# false = relay mode (forward immediately, requires stable internet)
# true  = buffer mode (queue scan results in SQLite, flush when online)
BUFFER_MODE=false

# How often (seconds) to flush the buffer to the Worker (buffer mode only)
FLUSH_INTERVAL=60

# How often (seconds) the bridge sends a heartbeat to the Worker
HEARTBEAT_INTERVAL=30
